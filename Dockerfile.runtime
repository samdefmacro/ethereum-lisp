# Runtime client image: a non-root container whose entrypoint IS the client.
#
# Deliberately separate from ./Dockerfile, which is a *test* image: that one
# carries a Go toolchain, build-essential, RocksDB sources, Quicklisp and the
# test tree, bind-mounts the workspace, and never runs the client as an
# artifact. Nothing in this image can compile Lisp or C. What ships is one
# executable with the SBCL runtime embedded in it, the shared libraries the
# client dlopens, and the KZG trusted setup.
#
# The build stages are:
#   native  -- compile RocksDB, libethckzg and libethbls; stage trusted_setup
#   lisp    -- load the system under SBCL and SAVE-LISP-AND-DIE an executable
#   runtime -- debian-slim plus the artifacts, non-root, no toolchain
#
# Base images are pinned by digest (plan section 10). Refresh them with
#   docker buildx imagetools inspect debian:bookworm-slim
# and update BOTH occurrences; they must stay identical so the runtime stage
# links against exactly the libc the natives were compiled on.
#
# Build:
#   docker build --file Dockerfile.runtime --tag ethereum-lisp-runtime:dev .
# Run with a read-only root filesystem; the datadir must be writable by uid
# 10001, which for a tmpfs means saying so:
#   docker run --rm --read-only \
#     --mount type=tmpfs,destination=/data,tmpfs-mode=1777 \
#     ethereum-lisp-runtime:dev --hoodi --datadir /data

# ---------------------------------------------------------------------------
# Stage 1: native libraries.
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS native

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libbz2-dev \
        libgflags-dev \
        liblz4-dev \
        libsnappy-dev \
        liburing-dev \
        libzstd-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# RocksDB from the same checksummed archive the test image vendors, so both
# images run against one storage-engine version. Keep the version synchronized
# with docs/storage-substrate.md, ./Dockerfile and the CFFI backend.
# -j2, not -j$(nproc): several agents build on this machine at once and cc1plus
# on RocksDB's larger translation units is a gigabyte apiece, so a wide build
# gets OOM-killed rather than going faster.
COPY tools/rocksdb/rocksdb-11.1.2.tar.gz /opt/rocksdb-11.1.2.tar.gz
COPY tools/rocksdb/io-uring-kernel-compat.patch /opt/io-uring-kernel-compat.patch
RUN --network=none \
    echo "d5e78b69e0fb2960576fd5f21c9f3d1a02f635da61159b01942ff285e891c9c0  /opt/rocksdb-11.1.2.tar.gz" \
        | sha256sum -c - \
    && mkdir /opt/rocksdb \
    && tar -xzf /opt/rocksdb-11.1.2.tar.gz -C /opt/rocksdb --strip-components=1 \
    && patch -d /opt/rocksdb -p1 --fuzz=0 --input=/opt/io-uring-kernel-compat.patch \
    && make -C /opt/rocksdb -j2 shared_lib PORTABLE=1 DISABLE_WARNING_AS_ERROR=1 ROCKSDB_USE_IO_URING=1 \
    && cp -a /opt/rocksdb/librocksdb.so* /usr/local/lib/ \
    && readelf -d /usr/local/lib/librocksdb.so \
        | grep -F 'Shared library: [liburing.so.2]' \
    && strip --strip-unneeded /usr/local/lib/librocksdb.so.*.*.* \
    && ldconfig \
    && rm -rf /opt/rocksdb /opt/rocksdb-11.1.2.tar.gz \
        /opt/io-uring-kernel-compat.patch

COPY tools/rocksdb/io-uring-probe.c /opt/io-uring-probe.c
RUN mkdir -p /usr/local/libexec \
    && gcc -O2 -Wall -Wextra -Werror /opt/io-uring-probe.c \
        -o /usr/local/libexec/ethereum-lisp-io-uring-probe -luring \
    && strip --strip-unneeded /usr/local/libexec/ethereum-lisp-io-uring-probe \
    && rm /opt/io-uring-probe.c

# Every downloaded input from here on is checked against
# tools/build-inputs/inputs.lock before it is loaded, executed or compiled
# (plan section 10). Copied after the RocksDB layer, whose archive is vendored
# and checked inline above, so a lock-file change does not rebuild RocksDB.
COPY tools/build-inputs/inputs.lock tools/build-inputs/verify-inputs.sh /opt/build-inputs/

# c-kzg-4844 (which bundles blst) behind the two stable byte-pointer shims, as
# in ./Dockerfile: libethckzg for KZG, libethbls for EIP-2537. Cloned by tag,
# then held to the pinned commits and tree digests before anything builds.
# Every new shim.c must also be un-ignored in .dockerignore or it silently
# vanishes from the build context.
COPY tools/ckzg-ffi/shim.c /opt/ckzg-shim.c
COPY tools/bls-ffi/shim.c /opt/bls-shim.c
RUN git clone --depth 1 --branch v2.1.1 --recurse-submodules \
        https://github.com/ethereum/c-kzg-4844.git /opt/c-kzg \
    && /opt/build-inputs/verify-inputs.sh \
        git c-kzg-4844 /opt/c-kzg \
        git blst /opt/c-kzg/blst \
    && cd /opt/c-kzg/blst && ./build.sh -fPIC \
    && cd /opt/c-kzg \
    && gcc -shared -fPIC -O2 -o /usr/local/lib/libethckzg.so \
        /opt/ckzg-shim.c src/ckzg.c -Isrc -Iblst/bindings blst/libblst.a \
    && gcc -shared -fPIC -O2 -o /usr/local/lib/libethbls.so \
        /opt/bls-shim.c -Iblst/bindings blst/libblst.a \
    && strip --strip-unneeded /usr/local/lib/libethckzg.so /usr/local/lib/libethbls.so \
    && ldconfig \
    && mkdir -p /usr/local/share/eth-kzg \
    && cp src/trusted_setup.txt /usr/local/share/eth-kzg/trusted_setup.txt \
    && rm -rf /opt/c-kzg /opt/ckzg-shim.c /opt/bls-shim.c

# ---------------------------------------------------------------------------
# Stage 2: the client executable.
# ---------------------------------------------------------------------------
FROM native AS lisp

# Build arguments are scoped to a Docker stage.  Declare REVISION here as well
# as in the final stage so the saved Lisp image and its OCI label identify the
# same source revision.
ARG REVISION=unknown
ENV ETHEREUM_LISP_BUILD_REVISION=${REVISION}

# libsecp256k1-1 and libsnappy1v5, not their -dev packages, are load-bearing.
# SAVE-LISP-AND-DIE records the exact namestring each shared object was opened
# under and re-dlopens that string on startup. The binding tries
# (:or "libsecp256k1.so" "libsecp256k1.so.1" ...), so a builder carrying the
# -dev package's unversioned symlink bakes "libsecp256k1.so" into the core, and
# the runtime layer -- which has only the versioned soname -- then dies before
# main with "cannot open shared object file". Nothing here compiles against the
# headers; CFFI dlopens at runtime.
#
# SBCL is pinned to one Debian version and its installed files to a digest per
# architecture (inputs.lock): its runtime is embedded in the shipped executable.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libsecp256k1-1 \
        libsnappy1v5 \
        sbcl=2:2.2.9-1 \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/build-inputs/verify-inputs.sh deb sbcl sbcl

# Quicklisp supplies the two systems the .asd declares. mgl-pax is NOT fetched:
# it exists only for scripts/docs-check.lisp, which is not part of a running
# node. Dist pinned to the same date as ./Dockerfile.
#
# Nothing downloaded runs before it is verified. The client is the pinned
# 2021-02-13 release, fetched over HTTPS and checked against inputs.lock before
# SBCL loads it, and laid out exactly as quicklisp-quickstart:install would;
# the pre-made dists/ directory stops it installing the moving default dist.
# The client then installs the pinned dist and only DOWNLOADS the releases
# QUICKLOAD would load (the same load strategy), and every index and archive
# is verified before the build compiles any of it with networking disabled.
RUN mkdir -p /root/quicklisp/dists \
    && curl -fsSL --proto '=https' --tlsv1.2 \
        https://beta.quicklisp.org/client/2021-02-13/quicklisp.tar -o /tmp/quicklisp.tar \
    && curl -fsSL --proto '=https' --tlsv1.2 \
        https://beta.quicklisp.org/client/2021-02-11/setup.lisp -o /root/quicklisp/setup.lisp \
    && curl -fsSL --proto '=https' --tlsv1.2 \
        https://beta.quicklisp.org/asdf/3.2.1/asdf.lisp -o /root/quicklisp/asdf.lisp \
    && /opt/build-inputs/verify-inputs.sh \
        file quicklisp-client /tmp/quicklisp.tar \
        file quicklisp-setup /root/quicklisp/setup.lisp \
        file quicklisp-asdf /root/quicklisp/asdf.lisp \
    && tar -xf /tmp/quicklisp.tar -C /root/quicklisp \
    && rm /tmp/quicklisp.tar \
    && sbcl --non-interactive \
            --load /root/quicklisp/setup.lisp \
            --eval '(ql-dist:install-dist "http://beta.quicklisp.org/dist/quicklisp/2026-01-01/distinfo.txt" :prompt nil)' \
            --eval '(dolist (system (list "ironclad" "cffi")) (map nil (function ql-dist:ensure-installed) (ql::quicklisp-releases (ql::compute-load-strategy system))))' \
    && /opt/build-inputs/verify-inputs.sh quicklisp-dist /root/quicklisp/dists/quicklisp

ENV CL_SOURCE_REGISTRY=/root/quicklisp/dists/quicklisp/software//:

# /opt/ethereum-lisp is load-bearing, not arbitrary: GENESIS-ALLOCATION-PATH
# resolves the built-in mainnet/sepolia/holesky/hoodi allocations through
# ASDF:SYSTEM-RELATIVE-PATHNAME at call time, so the saved image looks for them
# under the directory the .asd was loaded from. The runtime stage recreates
# exactly this path with the .asd and alloc-data in it; change one and change
# the other, or every --mainnet/--hoodi start dies looking for an RLP file.
WORKDIR /opt/ethereum-lisp
COPY ethereum-lisp.asd ./ethereum-lisp.asd
COPY src ./src

# --disable-debugger is set inside the toplevel because the whole tree is
# written for `sbcl --script` semantics: CLAUDE.md's rule that every thread body
# handles its own conditions assumes an unhandled one kills the process rather
# than dropping a headless container into the debugger.
#
# COPY-then-load rather than piping the forms into `--load /dev/stdin`: SBCL's
# source loader wants a seekable stream and dies reading form 1 from a pipe.
COPY <<'LISP' /opt/build-core.lisp
(require :asdf)
(asdf:load-asd #p"/opt/ethereum-lisp/ethereum-lisp.asd")
(asdf:load-system :ethereum-lisp)
(defun runtime-toplevel ()
  (sb-ext:disable-debugger)
  (let ((code (ethereum-lisp.cli:main (cdr sb-ext:*posix-argv*))))
    (finish-output *standard-output*)
    (finish-output *error-output*)
    (sb-ext:exit :code code :abort nil)))
(sb-ext:save-lisp-and-die "/opt/ethereum-lisp/ethereum-lisp"
                          :executable t
                          :toplevel #'runtime-toplevel
                          :save-runtime-options t)
LISP
# No network: every system it compiles must already be on disk and verified.
RUN --network=none sbcl --dynamic-space-size 6144 --non-interactive --load /opt/build-core.lisp

# :save-runtime-options t means the SBCL runtime parses NO argv of its own, so
# `ethereum-lisp --version` is the client's flag and not SBCL's.  It also freezes
# the builder's dynamic-space limit into the executable.  A default SBCL heap is
# too small for bounded multi-source snap pages plus concurrent Engine traffic;
# reserve an explicit 6 GiB dynamic space. The range scheduler bounds decoded
# account pages and explicitly reclaims promoted page graphs, so two additional
# GiB no longer justify starving a colocated consensus client on the documented
# 16-GiB deployment profile. SBCL commits it on demand, while the operator's
# container memory limit remains the physical RSS authority.
RUN /opt/ethereum-lisp/ethereum-lisp version

# ---------------------------------------------------------------------------
# Stage 3: runtime.
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

ARG REVISION=unknown

LABEL org.opencontainers.image.title="ethereum-lisp" \
      org.opencontainers.image.description="Common Lisp Ethereum execution-layer client" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${REVISION}"

# Runtime shared-library closure only: no compiler, no headers, no sbcl (the
# SBCL runtime is inside the executable), no Quicklisp, no source tree beyond
# the two files the genesis presets resolve against.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libbz2-1.0 \
        libgflags2.2 \
        liblz4-1 \
        libsecp256k1-1 \
        libsnappy1v5 \
        libstdc++6 \
        liburing2 \
        libzstd1 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=native /usr/local/lib/librocksdb.so* /usr/local/lib/
COPY --from=native /usr/local/libexec/ethereum-lisp-io-uring-probe /usr/local/libexec/ethereum-lisp-io-uring-probe
COPY --from=native /usr/local/lib/libethckzg.so /usr/local/lib/libethckzg.so
COPY --from=native /usr/local/lib/libethbls.so /usr/local/lib/libethbls.so
COPY --from=native /usr/local/share/eth-kzg/trusted_setup.txt /usr/local/share/eth-kzg/trusted_setup.txt
RUN ldconfig \
    && ldd /usr/local/lib/librocksdb.so \
        | grep -F 'liburing.so.2' \
    && ldd /usr/local/libexec/ethereum-lisp-io-uring-probe \
        | grep -F 'liburing.so.2'

COPY --from=lisp /opt/ethereum-lisp/ethereum-lisp /usr/local/bin/ethereum-lisp
COPY --from=lisp /opt/ethereum-lisp/ethereum-lisp.asd /opt/ethereum-lisp/ethereum-lisp.asd
COPY --from=lisp /opt/ethereum-lisp/src/protocol/genesis/alloc-data /opt/ethereum-lisp/src/protocol/genesis/alloc-data

# Non-root with a fixed uid so a bind-mounted datadir has a predictable owner.
# No VOLUME declaration: an implicit anonymous volume per container outlives
# `docker run` without --rm and is worse than making the caller say -v.
RUN groupadd --system --gid 10001 ethereum \
    && useradd --system --uid 10001 --gid 10001 --home-dir /data --shell /usr/sbin/nologin ethereum \
    && mkdir -p /data \
    && chown ethereum:ethereum /data
USER ethereum:ethereum
WORKDIR /data

# Start the client once, as the user that will run it, in the filesystem it will
# run in. This is not a formality: the core re-dlopens every shared object it
# recorded at save time, so a library present in the builder and absent here
# fails exactly at this line instead of at a container start nobody is watching.
RUN /usr/local/bin/ethereum-lisp version

# 8545 public JSON-RPC, 8551 authenticated Engine API, and devp2p/discv4 on
# 30303. Publishing remains an operator decision; the metadata records both
# transports now that the production node serves discovery as well as RLPx.
EXPOSE 8545 8551 30303/tcp 30303/udp

ENTRYPOINT ["/usr/local/bin/ethereum-lisp"]
